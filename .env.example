# Local development defaults. Do not commit real secrets.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Browser-visible capability configuration. These are not secret values.
# The public JWK and key id must match the private Trip signing key deployed to
# the trip-grant-signer Edge function.
VITE_TRIP_OFFLINE_GRANT_KEY_ID=replace-with-public-key-id
VITE_TRIP_OFFLINE_GRANT_PUBLIC_JWK=replace-with-public-jwk-json
VITE_PARTNER_EMAIL_PROVIDER_ENABLED=false
VITE_PARTNER_MEDIA_PROVIDER_ENABLED=false
VITE_PARTNER_SYNTHETIC_ENABLED=false

# Supabase Edge runtime baseline. Use the deployment secret store; never put a
# real service-role key, constrained JWT, provider credential, or encryption
# key in this file or in a VITE_* variable.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Candidate extraction, delivery, and cleanup.
CANDIDATE_EMAIL_HMAC_SECRET=replace-with-secret
CANDIDATE_PAYLOAD_SECRET=replace-with-secret
CANDIDATE_OUTBOUND_PROXY_URL=https://replace-with-pinning-proxy.example
CANDIDATE_OUTBOUND_PROXY_SIGNED_CREDENTIAL=replace-with-secret
CANDIDATE_WORKER_SECRET=replace-with-secret
CANDIDATE_CLEANUP_JWT=replace-with-constrained-jwt
CANDIDATE_CLEANUP_BUCKET=replace-with-private-bucket
CANDIDATE_CLEANUP_SCHEDULER_TOKEN=replace-with-secret

# Account lifecycle/export workers.
ACCOUNT_LIFECYCLE_WORKER_JWT=replace-with-constrained-jwt
ACCOUNT_LIFECYCLE_SCHEDULER_TOKEN=replace-with-secret
ACCOUNT_EXPORT_BUCKET=account-exports

# Trip proof-of-possession services.
TRIP_GRANT_SIGNER_JWT=replace-with-constrained-jwt
TRIP_GRANT_SIGNING_PRIVATE_JWK=replace-with-private-jwk-json
TRIP_GRANT_SIGNING_KEY_ID=replace-with-public-key-id
TRIP_GO_GATEWAY_JWT=replace-with-constrained-jwt

# Public catalog gateway.
PUBLIC_CATALOG_GATEWAY_JWT=replace-with-constrained-jwt
PUBLIC_APP_ORIGIN=https://replace-with-approved-origin.example
PUBLIC_CATALOG_RATE_SALT=replace-with-secret

# Partner provider boundary. Real email/media capabilities remain disabled
# until their named gates are accepted.
PARTNER_SYNTHETIC_ENABLED=false
APP_ORIGIN=https://replace-with-approved-origin.example
PARTNER_EMAIL_HMAC_SECRET=replace-with-secret
PARTNER_EMAIL_HMAC_KEY_VERSION=replace-with-positive-integer
PARTNER_EVIDENCE_HMAC_SECRET=replace-with-secret

# GitHub Actions secret names used by candidate-cleanup.yml. These are comments
# because they belong in the GitHub Actions secret store, not the local runtime.
# SUPABASE_CANDIDATE_CLEANUP_URL=https://replace-with-function-url.example
# CANDIDATE_CLEANUP_INVOKE_JWT=replace-with-function-invoke-jwt
# CANDIDATE_CLEANUP_SCHEDULER_TOKEN=replace-with-secret
VITE_BROWSE_MAP_ENABLED=false
VITE_BROWSE_MAP_ATTRIBUTION=
