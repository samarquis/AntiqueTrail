{
  "name": "antique-trail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.13.1",
  "scripts": {
    "dev": "vite",
    "dev:review": "vite --mode review",
    "build": "tsc -b && vite build",
    "build:owner-research": "tsc -b && vite build --mode owner-research --outDir dist-owner-research && node scripts/finalize-owner-research-artifact.mjs",
    "owner-research:teardown": "node scripts/owner-research-teardown.mjs",
    "verify:owner-research-artifacts": "node scripts/verify-owner-research-artifacts.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json,html}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json,html}\"",
    "test": "vitest run",
    "test:release": "node scripts/run-release-tests.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:review": "playwright test --config playwright.review.config.ts",
    "security:contract": "node scripts/security-contract.mjs",
    "security:audit": "npm audit --audit-level=high",
    "auth:provider-smoke": "node scripts/auth-provider-gate.mjs smoke",
    "db:post-boot": "docker exec -i -e PGPASSWORD=postgres supabase_db_antique-trail psql -U supabase_admin -d postgres -v ON_ERROR_STOP=1 < scripts/stress/post-boot.sql",
    "handoff": "node scripts/handoff.mjs",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test && npm run test:release && npm run build",
    "verify:baseline": "npm run security:contract && npm run security:audit && npm run check",
    "verify:web": "npm run verify:baseline && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.1",
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "vite": "6.4.3",
    "vite-plugin-pwa": "0.21.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.25",
    "prettier": "3.4.2",
    "qrcode": "1.5.4",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.1",
    "vitest": "4.1.10"
  }
}
